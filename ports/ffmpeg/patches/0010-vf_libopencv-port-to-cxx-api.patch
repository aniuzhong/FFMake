diff --git a/libavfilter/ocv_core.cpp b/libavfilter/ocv_core.cpp
new file mode 100644
index 0000000000..852fdab503
--- /dev/null
+++ b/libavfilter/ocv_core.cpp
@@ -0,0 +1,321 @@
+/*
+ * OpenCV 4 C++ core for the ocv filter (FFMake knowledge base port).
+ * The registration shell (vf_libopencv.c) stays C because ffmpeg's
+ * filter structures use designated initializers; this translation unit
+ * carries everything that touches OpenCV. Interface is extern "C".
+ */
+
+#include "config.h"
+
+#include <opencv2/core.hpp>
+#include <opencv2/imgproc.hpp>
+
+/* ffmpeg's libavutil headers carry no extern "C" guard of their own --
+ * wrap them or every symbol gets C++-mangled and the link fails */
+extern "C" {
+#include "libavutil/avstring.h"
+#include "libavutil/file.h"
+#include "libavutil/mem.h"
+#include "libavutil/log.h"
+#include "libavutil/pixfmt.h"
+#include "avfilter.h"
+}
+
+#include <cstring>
+#include <memory>
+#include <vector>
+
+using namespace cv;
+
+namespace {
+
+enum { SMOOTH_BLUR, SMOOTH_BLUR_NO_SCALE, SMOOTH_MEDIAN,
+       SMOOTH_GAUSSIAN, SMOOTH_BILATERAL };
+
+struct Core {
+    virtual ~Core() = default;
+    virtual void filter_frame(Mat &inimg, Mat &outimg) = 0;
+};
+
+struct SmoothCore : Core {
+    int type;
+    int    param1, param2;
+    double param3, param4;
+
+    void filter_frame(Mat &inimg, Mat &outimg) override
+    {
+        Size ksize(param1, param2 ? param2 : param1);
+
+        switch (type) {
+        case SMOOTH_BLUR:
+        case SMOOTH_BLUR_NO_SCALE:
+            /* blur_no_scale has no OpenCV 4 equivalent; the normalized
+             * blur is the closest surviving operation */
+            blur(inimg, outimg, ksize);
+            break;
+        case SMOOTH_MEDIAN:
+            medianBlur(inimg, outimg, param1);
+            break;
+        case SMOOTH_GAUSSIAN:
+            GaussianBlur(inimg, outimg, ksize, param3, param4);
+            break;
+        case SMOOTH_BILATERAL:
+            bilateralFilter(inimg, outimg, param1, param3, param4);
+            break;
+        }
+    }
+};
+
+struct MorphCore : Core {
+    int nb_iterations;
+    Mat kernel;
+
+    void filter_frame(Mat &inimg, Mat &outimg) override = 0;
+};
+
+struct DilateCore : MorphCore {
+    void filter_frame(Mat &inimg, Mat &outimg) override
+    {
+        dilate(inimg, outimg, kernel, Point(-1, -1), nb_iterations);
+    }
+};
+
+struct ErodeCore : MorphCore {
+    void filter_frame(Mat &inimg, Mat &outimg) override
+    {
+        erode(inimg, outimg, kernel, Point(-1, -1), nb_iterations);
+    }
+};
+
+int read_shape_from_file(int *cols, int *rows, int **values,
+                         const char *filename, void *log_ctx)
+{
+    uint8_t *buf, *p, *pend;
+    size_t size;
+    int ret, i, j, w;
+
+    if ((ret = av_file_map(filename, &buf, &size, 0, log_ctx)) < 0)
+        return ret;
+
+    w = 0;
+    for (i = 0; i < size; i++) {
+        if (buf[i] == '\n') {
+            if (*rows == INT_MAX) {
+                av_log(log_ctx, AV_LOG_ERROR, "Overflow on the number of rows in the file\n");
+                ret = AVERROR_INVALIDDATA;
+                goto end;
+            }
+            ++(*rows);
+            *cols = FFMAX(*cols, w);
+            w = 0;
+        } else if (w == INT_MAX) {
+            av_log(log_ctx, AV_LOG_ERROR, "Overflow on the number of columns in the file\n");
+            return AVERROR_INVALIDDATA;
+        }
+        w++;
+    }
+    if (*rows > (SIZE_MAX / sizeof(int) / *cols)) {
+        av_log(log_ctx, AV_LOG_ERROR, "File with size %dx%d is too big\n",
+               *rows, *cols);
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+    if (!(*values = (int *)av_calloc(*cols, sizeof(**values) * *rows))) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+
+    p    = buf;
+    pend = buf + size - 1;
+    for (i = 0; i < *rows; i++) {
+        for (j = 0;; j++) {
+            if (p > pend || *p == '\n') {
+                p++;
+                break;
+            } else
+                (*values)[*cols * i + j] = !!av_isgraph(*(p++));
+        }
+    }
+
+end:
+    av_file_unmap(buf, size);
+
+    return 0;
+}
+
+int parse_kernel(Mat *kernel, char *buf, void *log_ctx)
+{
+    char shape_filename[128] = "", shape_str[32] = "rect";
+    int cols = 0, rows = 0, anchor_x = 0, anchor_y = 0;
+    int *values = NULL, ret = 0;
+    int shape;
+
+    sscanf(buf, "%dx%d+%dx%d/%31[^=]=%127s", &cols, &rows, &anchor_x, &anchor_y,
+           shape_str, shape_filename);
+
+    if      (!strcmp(shape_str, "rect"))    shape = MORPH_RECT;
+    else if (!strcmp(shape_str, "cross"))   shape = MORPH_CROSS;
+    else if (!strcmp(shape_str, "ellipse")) shape = MORPH_ELLIPSE;
+    else if (!strcmp(shape_str, "custom")) {
+        if ((ret = read_shape_from_file(&cols, &rows, &values, shape_filename,
+                                        log_ctx)) < 0)
+            return ret;
+        *kernel = Mat(rows, cols, CV_8UC1);
+        for (int i = 0; i < rows * cols; i++)
+            kernel->data[i] = values[i] ? 1 : 0;
+        av_freep(&values);
+        return 0;
+    } else {
+        av_log(log_ctx, AV_LOG_ERROR,
+               "Shape unspecified or type '%s' unknown.\n", shape_str);
+        av_freep(&values);
+        return AVERROR(EINVAL);
+    }
+
+    if (rows <= 0 || cols <= 0) {
+        av_log(log_ctx, AV_LOG_ERROR,
+               "Invalid non-positive values for shape size %dx%d\n", cols, rows);
+        return AVERROR(EINVAL);
+    }
+
+    if (anchor_x < 0 || anchor_y < 0 || anchor_x >= cols || anchor_y >= rows) {
+        av_log(log_ctx, AV_LOG_ERROR,
+               "Shape anchor %dx%d is not inside the rectangle with size %dx%d.\n",
+               anchor_x, anchor_y, cols, rows);
+        return AVERROR(EINVAL);
+    }
+
+    *kernel = getStructuringElement(shape, Size(cols, rows),
+                                    Point(anchor_x, anchor_y));
+
+    av_log(log_ctx, AV_LOG_VERBOSE,
+           "Structuring element: w:%d h:%d x:%d y:%d shape:%s\n",
+           rows, cols, anchor_x, anchor_y, shape_str);
+    return ret;
+}
+
+int morph_init(MorphCore *morph, const char *args)
+{
+    char default_kernel_str[] = "3x3+0x0/rect";
+    char *kernel_str = NULL;
+    const char *buf = args;
+    int ret;
+
+    if (args) {
+        kernel_str = av_get_token(&buf, "|");
+        if (!kernel_str)
+            return AVERROR(ENOMEM);
+    }
+
+    ret = parse_kernel(&morph->kernel,
+                       (!kernel_str || !*kernel_str) ? default_kernel_str
+                                                     : kernel_str,
+                       NULL);
+    av_free(kernel_str);
+    if (ret < 0)
+        return ret;
+
+    if (!buf || sscanf(buf, "|%d", &morph->nb_iterations) != 1)
+        morph->nb_iterations = 1;
+    if (morph->nb_iterations <= 0) {
+        av_log(NULL, AV_LOG_ERROR,
+               "Invalid non-positive value '%d' for nb_iterations\n",
+               morph->nb_iterations);
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+int smooth_init(SmoothCore *smooth, const char *args)
+{
+    char type_str[128] = "gaussian";
+
+    smooth->param1 = 3;
+    smooth->param2 = 0;
+    smooth->param3 = 0.0;
+    smooth->param4 = 0.0;
+
+    if (args)
+        sscanf(args, "%127[^|]|%d|%d|%lf|%lf", type_str, &smooth->param1,
+               &smooth->param2, &smooth->param3, &smooth->param4);
+
+    if      (!strcmp(type_str, "blur"))          smooth->type = SMOOTH_BLUR;
+    else if (!strcmp(type_str, "blur_no_scale")) smooth->type = SMOOTH_BLUR_NO_SCALE;
+    else if (!strcmp(type_str, "median"))        smooth->type = SMOOTH_MEDIAN;
+    else if (!strcmp(type_str, "gaussian"))      smooth->type = SMOOTH_GAUSSIAN;
+    else if (!strcmp(type_str, "bilateral"))     smooth->type = SMOOTH_BILATERAL;
+    else {
+        av_log(NULL, AV_LOG_ERROR, "Smoothing type '%s' unknown.\n", type_str);
+        return AVERROR(EINVAL);
+    }
+
+    if (smooth->param1 < 0 || !(smooth->param1 % 2)) {
+        av_log(NULL, AV_LOG_ERROR,
+               "Invalid value '%d' for param1, it has to be a positive odd number\n",
+               smooth->param1);
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
+
+int mat_type_from_pixfmt(int pixfmt)
+{
+    if      (pixfmt == AV_PIX_FMT_GRAY8) return CV_8UC1;
+    else if (pixfmt == AV_PIX_FMT_BGR24) return CV_8UC3;
+    else if (pixfmt == AV_PIX_FMT_BGRA)  return CV_8UC4;
+    return -1;
+}
+
+} // namespace
+
+extern "C" {
+
+int ocv_core_init(AVFilterContext *ctx, const char *name, const char *params,
+                  void **core)
+{
+    if (!strcmp(name, "dilate")) {
+        DilateCore *c = new DilateCore();
+        int ret = morph_init(c, params);
+        if (ret < 0) { delete c; return ret; }
+        *core = c;
+        return 0;
+    }
+    if (!strcmp(name, "erode")) {
+        ErodeCore *c = new ErodeCore();
+        int ret = morph_init(c, params);
+        if (ret < 0) { delete c; return ret; }
+        *core = c;
+        return 0;
+    }
+    if (!strcmp(name, "smooth")) {
+        SmoothCore *c = new SmoothCore();
+        int ret = smooth_init(c, params);
+        if (ret < 0) { delete c; return ret; }
+        *core = c;
+        return 0;
+    }
+    av_log(ctx, AV_LOG_ERROR, "No libopencv filter named '%s'\n", name);
+    return AVERROR(EINVAL);
+}
+
+void ocv_core_uninit(void **core)
+{
+    delete (Core *)*core;
+    *core = NULL;
+}
+
+int ocv_core_filter_frame(void *core, AVFrame *in, AVFrame *out, int pixfmt)
+{
+    int type = mat_type_from_pixfmt(pixfmt);
+    if (type < 0)
+        return AVERROR(EINVAL);
+
+    /* zero-copy: cv::Mat strides over the frame buffers */
+    Mat inimg(in->height, in->width, type, in->data[0], in->linesize[0]);
+    Mat outimg(out->height, out->width, type, out->data[0], out->linesize[0]);
+    ((Core *)core)->filter_frame(inimg, outimg);
+    return 0;
+}
+
+}
