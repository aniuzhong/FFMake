{
  "schema": 1,
  "ffmpeg": {
    "source": {
      "type": "git",
      "url": "https://git.ffmpeg.org/ffmpeg.git"
    }
  },
  "deps": {
    "nasm": {
      "tool": true,
      "system": "makefile",
      "source": {
        "type": "tar",
        "url": "https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz",
        "sha256": "1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148"
      },
      "configure_args": []
    },
    "libtool": {
      "tool": true,
      "system": "makefile",
      "source": {
        "type": "tar",
        "url": "https://mirrors.tuna.tsinghua.edu.cn/gnu/libtool/libtool-2.4.7.tar.gz",
        "sha256": "04e96c2404ea70c590c546eba4202a4e12722c640016c12b9b2f1ce3d481e9a8"
      },
      "configure_args": []
    },
    "ninja": {
      "tool": true,
      "system": "custom",
      "source": {
        "type": "git",
        "url": "https://github.com/ninja-build/ninja.git",
        "rev": "v1.12.1"
      },
      "steps": [
        "python3 {src}/configure.py --bootstrap",
        "cp -f {bdir}/ninja {tools}/bin/ninja"
      ]
    },
    "meson": {
      "tool": true,
      "system": "pip",
      "pip": {
        "require": ["meson==1.4.2"],
        "wrappers": {"meson": "mesonbuild.mesonmain:main"}
      }
    },
    "x264": {
      "match_names": ["libx264", "x264"],
      "pc": "x264",
      "system": "makefile",
      "source": {
        "type": "git",
        "url": "https://github.com/mirror/x264.git",
        "rev": "stable"
      },
      "configure_args": ["--enable-shared", "--disable-cli"]
    },
    "dav1d": {
      "match_names": ["dav1d"],
      "pc": "dav1d",
      "system": "meson",
      "source": {
        "type": "git",
        "url": "https://github.com/videolan/dav1d.git",
        "rev": "1.5.4"
      },
      "meson_args": ["-Denable_tests=false", "-Denable_tools=false"]
    },
    "zimg": {
      "match_names": ["zimg"],
      "pc": "zimg",
      "system": "makefile",
      "source": {
        "type": "tar",
        "url": "https://github.com/sekrit-twc/zimg/archive/refs/tags/release-3.0.5.tar.gz",
        "sha256": "a9a0226bf85e0d83c41a8ebe4e3e690e1348682f6a2a7838f1b8cbff1b799bcf"
      },
      "autogen": "sh {src}/autogen.sh",
      "configure_args": []
    },
    "sdl2": {
      "match_names": ["sdl2"],
      "pc": "sdl2",
      "system": "cmake",
      "source": {
        "type": "git",
        "url": "https://github.com/libsdl-org/SDL.git",
        "rev": "release-2.30.9"
      },
      "cmake_args": [
        "-DSDL_SHARED=ON",
        "-DSDL_STATIC=OFF",
        "-DSDL_TEST_LIBRARY=OFF"
      ]
    },
    "x265": {
      "match_names": ["x265"],
      "pc": "x265",
      "system": "cmake",
      "source": {
        "type": "git",
        "url": "https://github.com/Multicorewareinc/x265.git",
        "rev": "3.6"
      },
      "source_dir": "source",
      "cmake_args": [
        "-DENABLE_SHARED=ON",
        "-DENABLE_CLI=OFF",
        "-DENABLE_PIC=ON",
        "-DENABLE_LIBNUMA=OFF"
      ],
      "fixups": ["x265"],
      "hook": {"pc_version": "3.6"}
    }
  }
}
