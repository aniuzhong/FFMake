{
  "schema": 1,
  "deps": {
    "nasm": {
      "tool": true,
      "system": "makefile",
      "source": {
        "type": "tar",
        "url": "https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz"
      },
      "configure_args": []
    },
    "x264": {
      "match_names": ["libx264", "x264"],
      "pc": "x264",
      "system": "makefile",
      "source": {
        "type": "git",
        "url": "https://github.com/mirror/x264.git",
        "rev": "stable"
      },
      "configure_args": ["--enable-shared", "--disable-cli"]
    }
  }
}
